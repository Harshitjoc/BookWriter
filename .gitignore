# Node deps for the Playwright tools.
node_modules/

# Local secrets (only needed for `gen-image.mjs --provider gemini`). Never commit.
.env

# Editor settings
.vscode/
.idea/

# Scratch dumps, never part of the build.
.scratch/

# Regenerable output. The assembled book.html IS committed (so you can read a
# book on GitHub without building it); the heavy renders are not.
*.pdf

# shot.mjs writes page1.png, page2.png ... into the book's own folder by default.
# Scoped to books/ on purpose: a bare `page*.png` would also swallow documentation
# images like docs/images/page-anatomy.png, silently, and break the README on GitHub.
books/**/page*.png
/page*.png

# A page pack renders its pages with shot.mjs into pages/<slug>/. Same rule as
# books/: the standalone pages.html is kept, the heavy renders are not.
pages/**/page*.png

# make-video.mjs writes frames, clips, voice and the finished mp4 into
# books/<slug>/video/. All regenerable from the storyboard; none of it is source.
books/**/video/

# A production build of the cockpit (if you ever run `vite build`). The cockpit
# normally runs from source through Vite in middleware mode and writes no output.
dist/

# Review screenshots of the cockpit, shot by hand at a few widths. Local only:
# they are for looking at, not for the repository.
cockpit-shots/

# The kit sheets (cast.mjs --sheet, gen-figure.mjs --sheet) and figure renders.
# Written to look at, never part of a book or the build.
cast-sheet.html
figures-sheet.html
figure-shots/
